. 
. use "$PANEL", clear

. quietly summarize investor_green if sample_current == 1

. gen double investor_green_z = (investor_green - r(mean)) / r(sd) if !missing(investor_green)
(20,528 missing values generated)

. 
. tempname R JN

. postfile `R' str12 table str36 model str32 contrast double b se p lb ub N firms using "$RESULTS/tables_6_to_7.dta", replace

. postfile `JN' str12 sample double root_low root_high observed_min observed_max N firms using "$RESULTS/johnson_neyman.dta", replace

. 
. * Table 6, Panel A: InvestorGreen moderation.
. foreach window in full no2023 {
  2.     local condition "sample_current == 1 & !missing(investor_green_z)"
  3.     if "`window'" == "no2023" local condition "`condition' & year != 2023"
  4.     reghdfe mca_current c.alcohol_culture##c.investor_green_z $CONTROLS if `condition', absorb(firm_id industry_year) vce(cluster firm_id)
  5.     lincom c.alcohol_culture#c.investor_green_z
  6.     post `R' ("Table 6") ("InvestorGreen `window'") ("Interaction") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N)) (e(N_clust))
  7.     lincom alcohol_culture - c.alcohol_culture#c.investor_green_z
  8.     post `R' ("Table 6") ("InvestorGreen `window'") ("Slope at -1 SD") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N)) (e(N_clust))
  9.     lincom alcohol_culture
 10.     post `R' ("Table 6") ("InvestorGreen `window'") ("Slope at mean") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N)) (e(N_clust))
 11.     lincom alcohol_culture + c.alcohol_culture#c.investor_green_z
 12.     post `R' ("Table 6") ("InvestorGreen `window'") ("Slope at +1 SD") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N)) (e(N_clust))
 13.     ereturn list
 14. 
.     margins, dydx(alcohol_culture) at(investor_green_z=(-2(.1)2)) saving("$RESULTS/investorgreen_margins_`window'.dta", replace)
 15.     marginsplot, recast(line) recastci(rarea) yline(0, lpattern(dash)) title("InvestorGreen moderation: `window'") name(ig_`window', replace)
 16.     graph export "$RESULTS/figures/investorgreen_margins_`window'.png", replace width(2400)
 17.     preserve
 18.     use "$RESULTS/investorgreen_margins_`window'.dta", clear
 19.     export delimited using "$RESULTS/investorgreen_margins_`window'.csv", replace datafmt
 20.     restore
 21. 
.     scalar b1 = _b[alcohol_culture]
 22.     scalar b3 = _b[c.alcohol_culture#c.investor_green_z]
 23.     matrix V = e(V)
 24.     scalar v11 = V["alcohol_culture","alcohol_culture"]
 25.     scalar v33 = V["c.alcohol_culture#c.investor_green_z","c.alcohol_culture#c.investor_green_z"]
 26.     scalar v13 = V["alcohol_culture","c.alcohol_culture#c.investor_green_z"]
 27.     scalar tc = invttail(e(df_r), .025)
 28.     scalar A = b3^2 - tc^2*v33
 29.     scalar B = 2*b1*b3 - 2*tc^2*v13
 30.     scalar C = b1^2 - tc^2*v11
 31.     scalar D = B^2 - 4*A*C
 32.     scalar lo = .
 33.     scalar hi = .
 34.     if D >= 0 & A != 0 {
 35.         scalar r1 = (-B-sqrt(D))/(2*A)
 36.         scalar r2 = (-B+sqrt(D))/(2*A)
 37.         scalar lo = min(r1,r2)
 38.         scalar hi = max(r1,r2)
 39.     }
 40.     quietly summarize investor_green_z if e(sample)
 41.     post `JN' ("`window'") (lo) (hi) (r(min)) (r(max)) (e(N)) (e(N_clust))
 42. }
