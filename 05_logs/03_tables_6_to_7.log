. foreach window in full no2023 {
  2.     local condition "sample_current == 1 & !missing(Pollute)"
  3.     if "`window'" == "no2023" local condition "`condition' & year != 2023"
  4.     reghdfe mca_current c.alcohol_culture##i.Pollute $CONTROLS if `condition', absorb(firm_id industry_year) vce(cluster firm_id)
  5.     lincom alcohol_culture
  6.     post `R' ("Table 7") ("Pollute `window'") ("Slope Pollute=0") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N)) (e(N_clust))
  7.     lincom alcohol_culture + 1.Pollute#c.alcohol_culture
  8.     post `R' ("Table 7") ("Pollute `window'") ("Slope Pollute=1") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N)) (e(N_clust))
  9.     lincom 1.Pollute#c.alcohol_culture
 10.     post `R' ("Table 7") ("Pollute `window'") ("Difference in slopes") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N)) (e(N_clust))
 11.     ereturn list
 12.     if "`window'" == "full" {
 13.         margins Pollute, dydx(alcohol_culture) saving("$RESULTS/pollute_slopes_full.dta", replace)
 14.         marginsplot, recast(scatter) recastci(rcap) yline(0, lpattern(dash)) title("AlcoholPOI slopes by Pollute") name(pollute_slopes, replace)
 15.         graph export "$RESULTS/figures/pollute_conditional_slopes.png", replace width(2400)
 16.     }
 17. }
