. 
. * Leave-one-year influence for the archived AlcoholPOI baseline.
. foreach omit in 2012 2013 2015 2016 2017 2018 2020 2021 2022 2023 {
  2.     reghdfe mca_current alcohol_culture $CONTROLS if sample_current == 1 & year != `omit', absorb(firm_id industry_year) vce(cluster firm_id)
  3.     lincom alcohol_culture
  4.     post `R' ("Leave one year out") ("mca_current") ("AlcoholPOI") ("omit `omit'") ("Average association") (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub)) (e(N)) (e(N_clust))
  5. }
